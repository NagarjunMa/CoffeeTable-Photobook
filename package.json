{
  "name": "photography-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:images": "tsx --test tests/image-delivery.test.ts",
    "test:browser": "playwright test",
    "test:browser:build": "NEXT_DIST_DIR=.next-test next build",
    "sync:cloudflare": "tsx scripts/sync-drive.ts --cloudflare",
    "verify:images": "tsx scripts/verify-images.ts",
    "images:retire-local": "npm run verify:images && tsx scripts/retire-local-photos.ts",
    "sync:drive": "tsx scripts/sync-drive.ts",
    "sync:drive:reset": "rm -f .google-drive-token.json && npm run sync:drive",
    "publish": "npm run sync:drive && npm run build && npx vercel@54.15.1 deploy --prod"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "clsx": "2.1.1",
    "googleapis": "173.0.0",
    "gsap": "3.15.0",
    "lenis": "1.3.23",
    "lucide-react": "1.46.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.2",
    "slugify": "1.6.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3"
  }
}

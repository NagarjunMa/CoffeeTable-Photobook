GOOGLE_DRIVE_ROOT_FOLDER_NAME=Photography

# Optional but recommended when the folder name is not unique.
# Find this in the Google Drive folder URL:
# https://drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Create an OAuth desktop client in Google Cloud Console.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# The script uses http://127.0.0.1:53682/oauth2callback for the first login.
GOOGLE_DRIVE_OAUTH_PORT=53682

# Cloudflare hosted Images. Keep these server-side; never prefix with NEXT_PUBLIC_.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_SIGNING_KEY=
CLOUDFLARE_IMAGES_URL_TTL_SECONDS=3600

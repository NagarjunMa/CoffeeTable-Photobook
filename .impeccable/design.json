      "html": "<a class=\"ds-open\" href=\"#collection\">Open photobook <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></a>",
      "css": ".ds-open{display:inline-flex;align-items:center;justify-content:space-between;gap:20px;padding:14px 0;border-block:1px solid var(--foreground);min-height:48px;width:100%;text-decoration:none;font-family:var(--font-sans),Arial,sans-serif;color:var(--foreground);font-size:15px}.ds-open:hover{color:var(--accent)}.ds-open:focus-visible{outline:2px solid currentColor;outline-offset:5px;}"

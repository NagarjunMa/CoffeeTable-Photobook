      "css": ".ds-close{display:flex;align-items:center;gap:10px;min-height:44px;padding:8px 14px;border:0;background:var(--paper);color:var(--foreground);font-family:var(--font-sans),Arial,sans-serif;font-size:14px;cursor:pointer}.ds-close:focus-visible{outline:2px solid currentColor;outline-offset:5px;}"

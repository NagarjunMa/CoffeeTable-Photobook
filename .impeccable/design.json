      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#photobooks\">Photobooks</a><a href=\"#about\">About</a><a href=\"#contact\">Contact</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:20px;background:var(--background);color:var(--foreground);font-family:var(--font-mono),\"Courier New\",monospace;font-size:12px;text-transform:uppercase}.ds-nav a{position:relative;display:inline-flex;align-items:center;min-height:44px;padding-inline:8px;color:inherit;text-decoration:none}.ds-nav a::after{position:absolute;right:0;bottom:-0.18rem;left:0;height:1px;content:\"\";background:currentColor;opacity:.35;transform:scaleX(0);transform-origin:right;transition:transform 360ms ease}.ds-nav a:hover::after{transform:scaleX(1);transform-origin:left}.ds-nav a:focus-visible{outline:2px solid currentColor;outline-offset:5px;}@media(max-width:639px){.ds-nav{gap:4px}}@media(prefers-reduced-motion:reduce){.ds-nav a::after{transition:none}}"
    },
    {
      "name": "Individual Paper Spread",
      "kind": "card",
      "refersTo": "detail-spread",
      "description": "Two paper leaves with a warmer plate page and collection-colored binding edges.",
      "html": "<article class=\"ds-spread\"><div class=\"ds-plate\"><p class=\"ds-imprint\">Nagarjun Mallesh</p><p class=\"ds-plate-title\">A photographic collection</p></div><div class=\"ds-copy\"><h2>Photobooks</h2><p>Places I’ve been. Moments I’ve kept.</p></div></article>",
      "css": ".ds-spread{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);background:var(--paper);color:var(--foreground);box-shadow:0 22px 64px rgb(0 0 0 / .35);border-block:6px solid #314d43;font-family:var(--font-sans),Arial,sans-serif;}.ds-plate{display:flex;flex-direction:column;justify-content:space-between;min-width:0;gap:36px;padding:32px;background:#eee8dc;box-shadow:inset -20px 0 28px -24px rgb(60 40 20 / .35)}.ds-imprint{margin:0;text-align:center;font-family:var(--font-mono),\"Courier New\",monospace;font-size:11px}.ds-plate-title{font-family:var(--font-display),Georgia,serif;font-size:26px;line-height:1.15;text-align:center}.ds-copy{padding:36px clamp(24px,3.5vw,48px) 32px;min-width:0}.ds-copy h2{margin:0 0 24px;font-family:var(--font-display),Georgia,serif;font-size:clamp(40px,4.8vw,68px);font-weight:400;line-height:1;overflow-wrap:anywhere;text-wrap:balance}.ds-copy p{font-size:16px;line-height:1.65}@media(max-width:767px){.ds-spread{grid-template-columns:minmax(0,1fr)}.ds-plate{padding:24px;gap:20px}.ds-copy{padding:28px 24px}}"
    },
    {
      "name": "Gallery Mat",

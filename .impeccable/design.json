      "name": "Shelf Arrow",
      "kind": "button",
      "refersTo": "shelf-control",
      "description": "Circular navigation beside the selected volume.",
      "html": "<button class=\"ds-shelf-control\" type=\"button\" aria-label=\"Next photobook\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14m-7-7 7 7-7 7\"/></svg></button>",
      "css": ".ds-shelf-control{display:grid;place-items:center;width:48px;height:48px;border:1px solid var(--line);background:transparent;color:var(--foreground);border-radius:50%;cursor:pointer;transition:background 180ms ease,color 180ms ease}.ds-shelf-control:hover{background:var(--foreground);color:var(--background)}.ds-shelf-control:focus-visible{outline:2px solid currentColor;outline-offset:5px;}@media(max-width:767px){.ds-shelf-control{width:44px;height:44px}}@media(prefers-reduced-motion:reduce){.ds-shelf-control{transition:none}}"
    },
